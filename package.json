{
    "name": "funniversaries-app",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "run-default": "vite dev --host",
        "run-test": "vite dev --host --mode test",
        "run-dev": "vite dev --host --mode dev",
        "run-production": "vite dev --host --mode production",
        "build": "vite build",
        "build:prod": "vite build --mode prod",
        "preview": "vite preview --host",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "vitest",
        "lint": "prettier --check ./src && eslint .",
        "lint-prettier": "prettier --check ./src",
        "lint-eslint": "eslint .",
        "format": "prettier --write .",
        "audit": "npm audit --audit-level moderate",
        "wasm": "wasm-pack build ../funniversaries-lib --target web"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "4.3.0",
        "@types/node": "^24",
        "@vitest/browser-playwright": "^4.1.8",
        "esbuild": "^0.28.2",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.19.0",
        "flowbite": "^4.0.2",
        "flowbite-svelte": "^1.33.1",
        "flowbite-svelte-icons": "^3.1.0",
        "globals": "^17.12.0",
        "playwright": "^1.60.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.0.16",
        "vite-plugin-wasm-pack": "^0.1.12",
        "vitest": "^4.1.8",
        "vitest-browser-svelte": "^2.1.1"
    },
    "type": "module",
    "dependencies": {
        "@msc29/funniversaries-lib": "^0.0.4",
        "@vite-pwa/sveltekit": "^1.1.0",
        "date-picker-svelte": "^2.12.0"
    }
}